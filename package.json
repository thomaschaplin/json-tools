{
  "name": "json-tools",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "The JSON workbench for engineers: format, validate, repair, query, diff, convert and generate types — in your browser.",
  "license": "MIT",
  "author": "Thomas Chaplin (https://thomaschaplin.me)",
  "homepage": "https://json.thomaschaplin.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomaschaplin/json-tools.git"
  },
  "bugs": {
    "url": "https://github.com/thomaschaplin/json-tools/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/generate-images.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json5": "^2.2.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
